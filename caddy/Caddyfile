:80 {
    # ── 1. Kottster/Vite Assets (Root leaks) ──────────────────────────────────
    # Vite dev mode often requests these at the domain root regardless of base path.
    @kottster_assets {
        path /main.jsx* /@vite/* /@id/* /@fs/* /node_modules/* /src/* /@react-refresh*
    }
    handle @kottster_assets {
        reverse_proxy data-management:5480
    }

    # ── 2. Admin Panel (Stripped Prefix) ──────────────────────────────────────
    # Strip /admin so the backend (configured with basePath: "") sees root-level paths.
    # This solves the Internal API and WebSocket resolution issues.
    redir /admin /admin/ 308

    handle_path /admin* {
        reverse_proxy data-management:5480 {
            header_up Upgrade {http.request.header.Upgrade}
            header_up Connection {http.request.header.Connection}
        }
    }

    # ── 3. Map Tiles & Data ───────────────────────────────────────────────────
    handle_path /maps* {
        root * /srv/local-map/data
        file_server
    }

    handle_path /data* {
        root * /srv/local-map/data
        file_server
    }

    # ── 4. Map Viewer (Root index only) ───────────────────────────────────────
    handle / {
        root * /srv/local-map
        file_server
    }

    # ── 5. Catch-all Fallback (Kottster) ──────────────────────────────────────
    handle /* {
        reverse_proxy data-management:5480
    }
}