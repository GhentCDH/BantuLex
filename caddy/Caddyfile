:80 {
    # ── Admin Panel (Kottster) ────────────────────────────────────────────────
    # Ensure trailing slash for /admin
    redir /admin /admin/

    handle /admin* {
        reverse_proxy data-management:5480
    }

    # Vite HMR (Websocket) - must go to port 5480
    handle /admin/kottster-dev-server* {
        reverse_proxy data-management:5480
    }

    # ── Map Tiles & Data ──────────────────────────────────────────────────────
    handle_path /maps* {
        root * /srv/local-map/data
        file_server
    }

    handle_path /data* {
        root * /srv/local-map/data
        file_server
    }

    # ── Root Routing (Map + Kottster Assets) ──────────────────────────────────
    # Catch assets that Vite/Kottster serves at root instead of /admin/ and rewrite them
    @kottster_assets {
        path /@vite/* /@id/* /@fs/* /node_modules/* /src/* /main.jsx* /@react-refresh*
    }
    handle @kottster_assets {
        rewrite * /admin{path}
        reverse_proxy data-management:5480
    }

    # Main Map viewer
    handle /* {
        root * /srv/local-map
        file_server
        header Cache-Control "public, max-age=3600"
    }
}
