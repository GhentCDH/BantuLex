{
  "$schema": "https://ghentcdh.github.io/crouton/schema/v1/resource.schema.json",
  "schemaVersion": 1,
  "draft": false,
  "name": "project",
  "route": "project",
  "title": "Projects",
  "source": {
    "model": "project",
    "datasource": "default",
    "idType": "number"
  },
  "openapi": {
    "tag": "project"
  },
  "sidebar": {
    "group": "fieldwork",
    "hide": false
  },
  "operations": {
    "findAll": {
      "search": [
        "name"
      ],
      "filter": [
        "id",
        "name",
        "created_at",
        "updated_at"
      ]
    },
    "findOne": true,
    "create": true,
    "update": true,
    "patch": true,
    "delete": true
  },
  "lookup": {
    "labels": [
      "name"
    ],
    "separator": " "
  },
  "columns": {
    "id": {
      "label": "Id",
      "type": {
        "type": [
          "integer"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": true,
      "createable": false,
      "updateable": false,
      "hiddenInTable": false,
      "idField": true
    },
    "name": {
      "label": "Name",
      "type": {
        "type": [
          "string",
          "null"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": false,
      "createable": true,
      "updateable": true,
      "hiddenInTable": false,
      "required": false,
      "fieldInput": {
        "type": "string"
      }
    },
    "created_at": {
      "label": "Created at",
      "type": {
        "type": [
          "string"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": true,
      "createable": false,
      "updateable": false,
      "hiddenInTable": true
    },
    "updated_at": {
      "label": "Updated at",
      "type": {
        "type": [
          "string"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": true,
      "createable": false,
      "updateable": false,
      "hiddenInTable": true
    },
    "display_label": {
      "label": "Reference",
      "hiddenInTable": true,
      "hiddenInView": true,
      "computed": {
        "sql": "SELECT COALESCE(NULLIF(x.name, ''), '#' || x.id) FROM \"project\" x WHERE x.id = main.id",
        "type": "string"
      }
    },
    "fieldwork_by_project_id": {
      "label": "Fieldworks",
      "hiddenInTable": true,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "related-table",
          "colspan": 12,
          "childResource": "fieldwork",
          "foreignKey": "project_id",
          "columns": []
        },
        "position": 1005
      },
      "computed": {
        "sql": "SELECT CAST(main.id AS TEXT)",
        "type": "string"
      }
    }
  },
  "layout": {
    "form": {
      "type": "grid",
      "columns": 12,
      "container": {
        "mode": "modal",
        "size": "xl"
      },
      "items": [
        {
          "id": "name",
          "colspan": 6
        }
      ]
    }
  }
}
