    {
      "id": "display_label",
      "alias": "display_label",
      "label": "Reference",
      "type": "string",
      "sqlExpression": "SELECT COALESCE(NULLIF(concat_ws(' \u00b7 ', x.blr_index, x.word, x.english), ''), '#' || x.id) FROM \"reconstruction\" x WHERE x.id = main.id",
      "hiddenInTable": true,
      "hiddenInView": true
    },
    {
      "id": "contributor_label",
      "alias": "contributor_label",
      "label": "Contributor",
      "type": "string",
      "sqlExpression": "SELECT COALESCE(NULLIF(x.name, ''), '#' || x.id) FROM \"blrcontributor\" x WHERE x.id = main.\"contributor_id\"",
