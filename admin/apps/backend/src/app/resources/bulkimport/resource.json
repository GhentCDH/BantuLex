      "createable": false,
      "updateable": false,
      "hiddenInTable": true,
      "required": false,
      "fieldInput": {
        "type": "autocomplete",
        "relationType": "manyToOne",
        "resource": "../location/resource.json",
        "options": {
          "valueKey": "id",
          "labelKey": "display_label",
          "storeValue": true,
          "resource": "/location/schemas",
          "enableCreate": false
        }
      }
    },
    "fieldwork_id": {
