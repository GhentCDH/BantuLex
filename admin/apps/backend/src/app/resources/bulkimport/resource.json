        ]
      },
      "hiddenInView": true,
      "hiddenInForm": false,
      "createable": false,
      "updateable": false,
      "hiddenInTable": true,
      "required": false,
      "fieldInput": {
        "type": "autocomplete",
        "relationType": "manyToOne",
        "resource": "../fieldwork/resource.json",
        "options": {
