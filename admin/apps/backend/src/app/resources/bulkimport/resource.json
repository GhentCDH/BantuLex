        "type": "boolean"
      }
    },
    "variety_created": {
      "label": "Variety created",
      "type": {
        "type": [
          "boolean"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": false,
      "createable": false,
      "updateable": false,
      "hiddenInTable": false,
      "required": true,
      "fieldInput": {
        "type": "boolean"
      }
    },
    "created_at": {
      "label": "Created at",
      "type": {
        "type": [
          "string"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": true,
      "createable": false,
      "updateable": false,
      "hiddenInTable": true
    },
    "updated_at": {
      "label": "Updated at",
      "type": {
        "type": [
          "string"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": true,
      "createable": false,
      "updateable": false,
      "hiddenInTable": true
    },
    "display_label": {
      "label": "Reference",
      "hiddenInTable": true,
      "hiddenInView": true,
      "computed": {
        "sql": "SELECT COALESCE(NULLIF(concat_ws(' \u00b7 ', x.label, x.created_at), ''), '#' || x.id) FROM \"bulkimport\" x WHERE x.id = main.id",
        "type": "string"
      }
    },
    "source_label": {
      "label": "Source",
      "hiddenInTable": false,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "relation-link",
          "colspan": 12,
          "linkResource": "source",
          "idKey": "source_id"
        },
        "position": 3
      },
      "computed": {
        "sql": "SELECT COALESCE(NULLIF(x.author_year, ''), '#' || x.id) FROM \"source\" x WHERE x.id = main.\"source_id\"",
        "type": "string"
      }
    },
    "variety_label": {
      "label": "Variety",
      "hiddenInTable": false,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "relation-link",
          "colspan": 12,
          "linkResource": "variety",
          "idKey": "variety_id"
        },
        "position": 10
      },
      "computed": {
        "sql": "SELECT COALESCE(NULLIF(COALESCE(x.name_english, x.name_bantu, x.name_french, x.name_bastin) || COALESCE(' (' || x.guthrie_index || ')', ''), ''), '#' || x.id) FROM \"variety\" x WHERE x.id = main.\"variety_id\"",
        "type": "string"
      }
    },
    "location_label": {
      "label": "Location",
      "hiddenInTable": false,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "relation-link",
          "colspan": 12,
          "linkResource": "location",
          "idKey": "location_id"
        },
        "position": 10
      },
      "computed": {
        "sql": "SELECT COALESCE(NULLIF(concat_ws(', ', (SELECT p.name FROM place p WHERE p.id = x.place_id), (SELECT r.name FROM region r WHERE r.id = x.region_id), (SELECT c.name FROM country c WHERE c.id = x.country_id)), ''), '#' || x.id) FROM \"location\" x WHERE x.id = main.\"location_id\"",
        "type": "string"
      }
    },
    "fieldwork_label": {
      "label": "Fieldwork",
      "hiddenInTable": false,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "relation-link",
          "colspan": 12,
          "linkResource": "fieldwork",
          "idKey": "fieldwork_id"
        },
        "position": 10
      },
      "computed": {
        "sql": "SELECT COALESCE(NULLIF(concat_ws(' \u00b7 ', (SELECT p.name FROM project p WHERE p.id = x.project_id), (SELECT y.value FROM collectionyear y WHERE y.id = x.collection_year_id), x.archive), ''), '#' || x.id) FROM \"fieldwork\" x WHERE x.id = main.\"fieldwork_id\"",
        "type": "string"
      }
    },
    "reflex_count": {
      "label": "Reflexes now",
      "hiddenInTable": false,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "string",
          "colspan": 12
        },
        "position": 4
      },
      "computed": {
        "sql": "SELECT COUNT(*) FROM \"reflex\" x WHERE x.bulkimport_id = main.id",
        "type": "string"
      }
    },
    "reflex_by_bulkimport_id": {
      "label": "Reflexes",
      "hiddenInTable": true,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "related-table",
          "colspan": 12,
          "childResource": "reflex",
          "foreignKey": "bulkimport_id",
          "columns": [
            {
              "key": "term",
              "label": "Term"
            },
            {
              "key": "translation",
              "label": "Translation"
            },
            {
              "key": "variety_label",
              "label": "Variety"
            }
          ]
        },
        "position": 1024
      },
      "computed": {
        "sql": "SELECT CAST(main.id AS TEXT)",
        "type": "string"
      }
    }
  },
  "layout": {
    "form": {
      "type": "grid",
      "columns": 12,
      "container": {
        "mode": "modal",
        "size": "xl"
      },
      "items": [
        {
          "id": "label",
          "colspan": 6
        },
        {
          "id": "note",
          "colspan": 12
        },
        {
          "id": "rows",
          "colspan": 6
        },
        {
          "id": "status",
          "colspan": 6
        },
        {
          "id": "undone_at",
          "colspan": 6
        },
        {
          "id": "role",
          "colspan": 6
        },
        {
          "id": "source_id",
          "colspan": 6
        },
        {
          "id": "variety_id",
          "colspan": 6
        },
        {
          "id": "location_id",
          "colspan": 6
        },
        {
          "id": "fieldwork_id",
          "colspan": 6
        },
        {
          "id": "source_created",
          "colspan": 6
        },
        {
          "id": "variety_created",
          "colspan": 6
        }
      ]
    }
  }
}
