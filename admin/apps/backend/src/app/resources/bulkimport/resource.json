        ]
      },
      "hiddenInView": true,
      "hiddenInForm": false,
      "createable": false,
      "updateable": false,
      "hiddenInTable": true,
      "required": false,
      "fieldInput": {
        "type": "autocomplete",
        "relationType": "manyToOne",
        "resource": "../source/resource.json",
        "options": {
          "valueKey": "id",
          "labelKey": "display_label",
