  "calculatedColumns": [
    {
      "id": "display_label",
      "alias": "display_label",
      "label": "Reference",
      "type": "string",
      "sqlExpression": "SELECT COALESCE(NULLIF(concat_ws(' \u00b7 ', x.label, x.created_at), ''), '#' || x.id) FROM \"bulkimport\" x WHERE x.id = main.id",
      "hiddenInTable": true,
      "hiddenInView": true
    },
    {
      "id": "source_label",
      "alias": "source_label",
      "label": "Source",
      "type": "string",
      "sqlExpression": "SELECT COALESCE(NULLIF(x.author_year, ''), '#' || x.id) FROM \"source\" x WHERE x.id = main.\"source_id\"",
      "position": 3,
      "hiddenInTable": false,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "string",
          "colspan": 12
        }
      }
    },
    {
      "id": "variety_label",
      "alias": "variety_label",
      "label": "Variety",
      "type": "string",
      "sqlExpression": "SELECT COALESCE(NULLIF(COALESCE(x.name_english, x.name_bantu, x.name_french, x.name_bastin) || COALESCE(' (' || x.guthrie_index || ')', ''), ''), '#' || x.id) FROM \"variety\" x WHERE x.id = main.\"variety_id\"",
      "position": 10,
      "hiddenInTable": false,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "string",
          "colspan": 12
        }
      }
    },
    {
      "id": "location_label",
      "alias": "location_label",
      "label": "Location",
      "type": "string",
      "sqlExpression": "SELECT COALESCE(NULLIF(concat_ws(', ', (SELECT p.name FROM place p WHERE p.id = x.place_id), (SELECT r.name FROM region r WHERE r.id = x.region_id), (SELECT c.name FROM country c WHERE c.id = x.country_id)), ''), '#' || x.id) FROM \"location\" x WHERE x.id = main.\"location_id\"",
      "position": 10,
      "hiddenInTable": false,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "string",
          "colspan": 12
        }
      }
    },
    {
      "id": "fieldwork_label",
      "alias": "fieldwork_label",
      "label": "Fieldwork",
      "type": "string",
      "sqlExpression": "SELECT COALESCE(NULLIF(concat_ws(' \u00b7 ', (SELECT p.name FROM project p WHERE p.id = x.project_id), (SELECT y.value FROM collectionyear y WHERE y.id = x.collection_year_id), x.archive), ''), '#' || x.id) FROM \"fieldwork\" x WHERE x.id = main.\"fieldwork_id\"",
      "position": 10,
      "hiddenInTable": false,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "string",
          "colspan": 12
        }
      }
    },
    {
      "id": "reflex_count",
      "alias": "reflex_count",
      "label": "Reflexes now",
      "type": "string",
      "sqlExpression": "SELECT COUNT(*) FROM \"reflex\" x WHERE x.bulkimport_id = main.id",
      "position": 4,
      "hiddenInTable": false,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "string",
          "colspan": 12
        }
      }
    }
