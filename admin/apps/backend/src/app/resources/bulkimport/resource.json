{
  "$schema": "https://ghentcdh.github.io/crouton/schema/v1/resource.schema.json",
  "schemaVersion": 1,
  "draft": false,
  "name": "bulkimport",
  "route": "bulkimport",
  "title": "Bulk imports",
  "source": {
    "model": "bulkimport",
    "datasource": "default",
    "idType": "number"
  },
  "openapi": {
    "tag": "bulkimport"
