    "display_label": {
      "label": "Reference",
      "hiddenInTable": true,
      "hiddenInView": true,
      "computed": {
        "sql": "SELECT COALESCE(NULLIF(concat_ws(' \u00b7 ', x.term, x.translation), ''), '#' || x.id) FROM \"reflex\" x WHERE x.id = main.id",
        "type": "string"
      }
    },
    "variety_label": {
      "label": "Variety",
      "hiddenInTable": false,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "relation-link",
          "colspan": 12,
          "linkResource": "variety",
          "idKey": "variety_id"
        },
        "position": 10
      },
      "computed": {
        "sql": "SELECT COALESCE(NULLIF(COALESCE(x.name_english, x.name_bantu, x.name_french, x.name_bastin) || COALESCE(' (' || x.guthrie_index || ')', ''), ''), '#' || x.id) FROM \"variety\" x WHERE x.id = main.\"variety_id\"",
        "type": "string"
      }
    },
    "location_label": {
      "label": "Location",
      "hiddenInTable": false,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "relation-link",
          "colspan": 12,
          "linkResource": "location",
          "idKey": "location_id"
        },
        "position": 10
      },
      "computed": {
        "sql": "SELECT COALESCE(NULLIF(concat_ws(', ', (SELECT p.name FROM place p WHERE p.id = x.place_id), (SELECT r.name FROM region r WHERE r.id = x.region_id), (SELECT c.name FROM country c WHERE c.id = x.country_id)), ''), '#' || x.id) FROM \"location\" x WHERE x.id = main.\"location_id\"",
        "type": "string"
      }
    },
    "fieldwork_label": {
      "label": "Fieldwork",
      "hiddenInTable": false,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "relation-link",
          "colspan": 12,
          "linkResource": "fieldwork",
          "idKey": "fieldwork_id"
        },
        "position": 10
      },
      "computed": {
        "sql": "SELECT COALESCE(NULLIF(concat_ws(' \u00b7 ', (SELECT p.name FROM project p WHERE p.id = x.project_id), (SELECT y.value FROM collectionyear y WHERE y.id = x.collection_year_id), x.archive), ''), '#' || x.id) FROM \"fieldwork\" x WHERE x.id = main.\"fieldwork_id\"",
        "type": "string"
      }
    },
    "blr_index": {
      "label": "BLR index",
      "hiddenInTable": false,
      "hiddenInView": true,
      "fieldInput": {
        "type": "string",
        "position": 10
      },
      "computed": {
        "sql": "SELECT CAST(x.blr_index AS TEXT) FROM \"reconstruction\" x WHERE x.id = main.\"blr_entry_id\"",
        "type": "string"
      }
    },
    "blr_entry_label": {
      "label": "Blr entry",
      "hiddenInTable": false,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "relation-link",
          "colspan": 12,
          "linkResource": "reconstruction",
          "idKey": "blr_entry_id"
        },
        "position": 10
      },
      "computed": {
        "sql": "SELECT COALESCE(NULLIF(concat_ws(' \u00b7 ', x.blr_index, x.word, x.english), ''), '#' || x.id) FROM \"reconstruction\" x WHERE x.id = main.\"blr_entry_id\"",
        "type": "string"
      }
    },
    "bulkimport_label": {
      "label": "Bulk import",
      "hiddenInTable": true,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "relation-link",
          "colspan": 12,
          "linkResource": "bulkimport",
          "idKey": "bulkimport_id"
        },
        "position": 20
      },
      "computed": {
        "sql": "SELECT COALESCE(NULLIF(x.label, ''), '#' || x.id) FROM \"bulkimport\" x WHERE x.id = main.\"bulkimport_id\"",
        "type": "string"
      }
    },
    "sourceentries_by_entry_id": {
      "label": "Source entries",
      "hiddenInTable": true,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "related-table",
          "colspan": 12,
          "childResource": "sourceentries",
          "foreignKey": "entry_id",
          "columns": [
            {
              "key": "role",
              "label": "Role"
            },
            {
              "key": "pages",
              "label": "Pages"
            },
            {
              "key": "source_label",
              "label": "Source"
            }
          ]
        },
        "position": 1026
      },
      "computed": {
        "sql": "SELECT CAST(main.id AS TEXT)",
        "type": "string"
      }
    }
  },
