{
  "$schema": "https://ghentcdh.github.io/crouton/schema/v1/resource.schema.json",
  "schemaVersion": 1,
  "draft": false,
  "name": "place",
  "route": "place",
  "title": "Places",
  "source": {
    "model": "place",
    "datasource": "default",
    "idType": "number"
  },
  "openapi": {
    "tag": "place"
  },
  "sidebar": {
    "group": "geography",
    "hide": false
  },
  "operations": {
    "findAll": {
      "search": [
        "name"
      ],
      "filter": [
        "id",
        "name",
        "region_id",
        "created_at",
        "updated_at"
      ]
    },
    "findOne": true,
    "create": true,
    "update": true,
    "patch": true,
    "delete": true
  },
  "lookup": {
    "labels": [
      "name"
    ],
    "separator": " "
  },
  "columns": {
    "id": {
      "label": "Id",
      "type": {
        "type": [
          "integer"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": true,
      "createable": false,
      "updateable": false,
      "hiddenInTable": false,
      "idField": true
    },
    "name": {
      "label": "Name",
      "type": {
        "type": [
          "string",
          "null"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": false,
      "createable": true,
      "updateable": true,
      "hiddenInTable": false,
      "required": false,
      "fieldInput": {
        "type": "string"
      }
    },
    "region_id": {
      "label": "Region",
      "type": {
        "type": [
          "integer",
          "null"
        ]
      },
      "hiddenInView": true,
      "hiddenInForm": false,
      "createable": true,
      "updateable": true,
      "hiddenInTable": true,
      "required": false,
      "fieldInput": {
        "type": "autocomplete",
        "relationType": "manyToOne",
        "resource": "../region/resource.json",
        "options": {
          "valueKey": "id",
          "labelKey": "display_label",
          "storeValue": true,
          "resource": "/region/schemas",
          "enableCreate": false
        }
      }
    },
    "created_at": {
      "label": "Created at",
      "type": {
        "type": [
          "string"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": true,
      "createable": false,
      "updateable": false,
      "hiddenInTable": true
    },
    "updated_at": {
      "label": "Updated at",
      "type": {
        "type": [
          "string"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": true,
      "createable": false,
      "updateable": false,
      "hiddenInTable": true
    },
    "display_label": {
      "label": "Reference",
      "hiddenInTable": true,
      "hiddenInView": true,
      "computed": {
        "sql": "SELECT COALESCE(NULLIF(x.name, ''), '#' || x.id) FROM \"place\" x WHERE x.id = main.id",
        "type": "string"
      }
    },
    "region_label": {
      "label": "Region",
      "hiddenInTable": false,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "relation-link",
          "colspan": 12,
          "linkResource": "region",
          "idKey": "region_id"
        },
        "position": 2
      },
      "computed": {
        "sql": "SELECT COALESCE(NULLIF(x.name, ''), '#' || x.id) FROM \"region\" x WHERE x.id = main.\"region_id\"",
        "type": "string"
      }
    },
    "location_by_place_id": {
      "label": "Locations",
      "hiddenInTable": true,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "related-table",
          "colspan": 12,
          "childResource": "location",
          "foreignKey": "place_id",
          "columns": []
        },
        "position": 1011
      },
      "computed": {
        "sql": "SELECT CAST(main.id AS TEXT)",
        "type": "string"
      }
    }
  },
  "layout": {
    "form": {
      "type": "grid",
      "columns": 12,
      "container": {
        "mode": "modal",
        "size": "xl"
      },
      "items": [
        {
          "id": "name",
          "colspan": 6
        },
        {
          "id": "region_id",
          "colspan": 6
        }
      ]
    }
  }
}
