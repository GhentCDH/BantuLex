      }
    },
    "data_entered_by": {
      "label": "Data entered by",
      "type": {
        "type": [
          "string",
          "null"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": false,
      "createable": true,
      "updateable": true,
      "hiddenInTable": false,
      "required": false,
      "fieldInput": {
        "type": "string"
      }
    },
    "created_at": {
      "label": "Created at",
      "type": {
        "type": [
          "string"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": true,
      "createable": false,
      "updateable": false,
      "hiddenInTable": true
    },
    "updated_at": {
      "label": "Updated at",
      "type": {
        "type": [
          "string"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": true,
      "createable": false,
      "updateable": false,
      "hiddenInTable": true
    },
    "display_label": {
      "label": "Reference",
      "hiddenInTable": true,
      "hiddenInView": true,
      "computed": {
        "sql": "SELECT COALESCE(NULLIF(concat_ws(' \u00b7 ', (SELECT p.name FROM project p WHERE p.id = x.project_id), (SELECT y.value FROM collectionyear y WHERE y.id = x.collection_year_id), x.archive), ''), '#' || x.id) FROM \"fieldwork\" x WHERE x.id = main.id",
        "type": "string"
      }
    },
    "project_label": {
      "label": "Project",
      "hiddenInTable": false,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "relation-link",
          "colspan": 12,
          "linkResource": "project",
          "idKey": "project_id"
        },
        "position": 1
      },
      "computed": {
        "sql": "SELECT COALESCE(NULLIF(x.name, ''), '#' || x.id) FROM \"project\" x WHERE x.id = main.\"project_id\"",
        "type": "string"
      }
    },
    "collection_year_label": {
      "label": "Collection year",
      "hiddenInTable": false,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "relation-link",
          "colspan": 12,
          "linkResource": "collectionyear",
          "idKey": "collection_year_id"
        },
        "position": 1
      },
      "computed": {
        "sql": "SELECT COALESCE(NULLIF(x.value || CASE WHEN x.status <> 'known' THEN ' (' || x.status || ')' ELSE '' END, ''), '#' || x.id) FROM \"collectionyear\" x WHERE x.id = main.\"collection_year_id\"",
        "type": "string"
      }
    },
    "bulkimport_by_fieldwork_id": {
      "label": "Bulk imports",
      "hiddenInTable": true,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "related-table",
          "colspan": 12,
          "childResource": "bulkimport",
          "foreignKey": "fieldwork_id",
          "columns": []
        },
        "position": 1003
      },
      "computed": {
        "sql": "SELECT CAST(main.id AS TEXT)",
        "type": "string"
      }
    },
