        "type": "string"
      }
    },
    "reflex_by_fieldwork_id": {
      "label": "Reflexes",
      "hiddenInTable": true,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "related-table",
          "colspan": 12,
          "childResource": "reflex",
          "foreignKey": "fieldwork_id",
          "columns": [
            {
              "key": "term",
              "label": "Term"
            },
            {
              "key": "translation",
              "label": "Translation"
            },
            {
              "key": "variety_label",
              "label": "Variety"
            }
          ]
        },
        "position": 1022
      },
      "computed": {
        "sql": "SELECT CAST(main.id AS TEXT)",
        "type": "string"
      }
    }
  },
  "layout": {
