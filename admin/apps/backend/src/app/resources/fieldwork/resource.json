  "calculatedColumns": [
    {
      "id": "display_label",
      "alias": "display_label",
      "label": "Reference",
      "type": "string",
      "sqlExpression": "SELECT COALESCE(NULLIF(concat_ws(' \u00b7 ', (SELECT p.name FROM project p WHERE p.id = x.project_id), (SELECT y.value FROM collectionyear y WHERE y.id = x.collection_year_id), x.archive), ''), '#' || x.id) FROM \"fieldwork\" x WHERE x.id = main.id",
      "hiddenInTable": true,
      "hiddenInView": true
    },
    {
      "id": "project_label",
      "alias": "project_label",
      "label": "Project",
      "type": "string",
      "sqlExpression": "SELECT COALESCE(NULLIF(x.name, ''), '#' || x.id) FROM \"project\" x WHERE x.id = main.\"project_id\"",
      "position": 1,
      "hiddenInTable": false,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "relation-link",
          "colspan": 12,
          "linkResource": "project",
          "idKey": "project_id"
        }
      }
    },
    {
      "id": "collection_year_label",
      "alias": "collection_year_label",
      "label": "Collection year",
      "type": "string",
      "sqlExpression": "SELECT COALESCE(NULLIF(x.value || CASE WHEN x.status <> 'known' THEN ' (' || x.status || ')' ELSE '' END, ''), '#' || x.id) FROM \"collectionyear\" x WHERE x.id = main.\"collection_year_id\"",
      "position": 1,
      "hiddenInTable": false,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "relation-link",
          "colspan": 12,
          "linkResource": "collectionyear",
          "idKey": "collection_year_id"
        }
      }
    }
  ]
