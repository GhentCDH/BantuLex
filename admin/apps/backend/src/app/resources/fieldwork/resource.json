          "integer"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": true,
      "createable": false,
      "updateable": false,
      "hiddenInTable": false,
      "idField": true
    },
    "project_id": {
      "label": "Project",
      "type": {
        "type": [
          "integer",
