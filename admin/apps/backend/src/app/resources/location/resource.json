{
  "$schema": "https://ghentcdh.github.io/crouton/schema/v1/resource.schema.json",
  "schemaVersion": 1,
  "draft": false,
  "name": "location",
  "route": "location",
  "title": "Locations",
  "source": {
    "model": "location",
    "datasource": "default",
    "idType": "number"
  },
  "openapi": {
    "tag": "location"
  },
  "sidebar": {
    "group": "geography",
    "hide": false
  },
  "operations": {
    "findAll": {
      "filter": [
        "id",
        "place_id",
        "region_id",
        "country_id",
        "created_at",
        "updated_at"
      ]
    },
    "findOne": true,
    "create": true,
    "update": true,
    "patch": true,
    "delete": true
  },
  "columns": {
    "id": {
      "label": "Id",
      "type": {
        "type": [
          "integer"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": true,
      "createable": false,
      "updateable": false,
      "hiddenInTable": false,
      "idField": true
    },
    "place_id": {
      "label": "Place",
      "type": {
        "type": [
          "integer",
          "null"
        ]
      },
      "hiddenInView": true,
      "hiddenInForm": false,
      "createable": true,
      "updateable": true,
      "hiddenInTable": true,
      "required": false,
      "fieldInput": {
        "type": "autocomplete",
        "relationType": "manyToOne",
        "resource": "../place/resource.json",
        "options": {
          "valueKey": "id",
          "labelKey": "display_label",
          "storeValue": true,
          "resource": "/place/schemas",
          "enableCreate": false
        }
      }
    },
    "region_id": {
      "label": "Region",
      "type": {
        "type": [
          "integer",
          "null"
        ]
      },
      "hiddenInView": true,
      "hiddenInForm": false,
      "createable": true,
      "updateable": true,
      "hiddenInTable": true,
      "required": false,
      "fieldInput": {
        "type": "autocomplete",
        "relationType": "manyToOne",
        "resource": "../region/resource.json",
        "options": {
          "valueKey": "id",
          "labelKey": "display_label",
          "storeValue": true,
          "resource": "/region/schemas",
          "enableCreate": false
        }
      }
    },
    "country_id": {
      "label": "Country",
      "type": {
        "type": [
          "integer",
          "null"
        ]
      },
      "hiddenInView": true,
      "hiddenInForm": false,
      "createable": true,
      "updateable": true,
      "hiddenInTable": true,
      "required": false,
      "fieldInput": {
        "type": "autocomplete",
        "relationType": "manyToOne",
        "resource": "../country/resource.json",
        "options": {
          "valueKey": "id",
          "labelKey": "display_label",
          "storeValue": true,
          "resource": "/country/schemas",
          "enableCreate": false
        }
      }
    },
    "created_at": {
      "label": "Created at",
      "type": {
        "type": [
          "string"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": true,
      "createable": false,
      "updateable": false,
      "hiddenInTable": true
    },
    "updated_at": {
      "label": "Updated at",
      "type": {
        "type": [
          "string"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": true,
      "createable": false,
      "updateable": false,
      "hiddenInTable": true
    },
    "display_label": {
      "label": "Reference",
      "hiddenInTable": true,
      "hiddenInView": true,
      "computed": {
        "sql": "SELECT COALESCE(NULLIF(concat_ws(', ', (SELECT p.name FROM place p WHERE p.id = x.place_id), (SELECT r.name FROM region r WHERE r.id = x.region_id), (SELECT c.name FROM country c WHERE c.id = x.country_id)), ''), '#' || x.id) FROM \"location\" x WHERE x.id = main.id",
        "type": "string"
      }
    },
    "place_label": {
      "label": "Place",
      "hiddenInTable": false,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "relation-link",
          "colspan": 12,
          "linkResource": "place",
          "idKey": "place_id"
        },
        "position": 1
      },
      "computed": {
        "sql": "SELECT COALESCE(NULLIF(x.name, ''), '#' || x.id) FROM \"place\" x WHERE x.id = main.\"place_id\"",
        "type": "string"
      }
    },
    "region_label": {
      "label": "Region",
      "hiddenInTable": false,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "relation-link",
          "colspan": 12,
          "linkResource": "region",
          "idKey": "region_id"
        },
        "position": 1
      },
      "computed": {
        "sql": "SELECT COALESCE(NULLIF(x.name, ''), '#' || x.id) FROM \"region\" x WHERE x.id = main.\"region_id\"",
        "type": "string"
      }
    },
    "country_label": {
      "label": "Country",
      "hiddenInTable": false,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "relation-link",
          "colspan": 12,
          "linkResource": "country",
          "idKey": "country_id"
        },
        "position": 1
      },
      "computed": {
        "sql": "SELECT COALESCE(NULLIF(x.name, ''), '#' || x.id) FROM \"country\" x WHERE x.id = main.\"country_id\"",
        "type": "string"
      }
    },
    "bulkimport_by_location_id": {
      "label": "Bulk imports",
      "hiddenInTable": true,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "related-table",
          "colspan": 12,
          "childResource": "bulkimport",
          "foreignKey": "location_id",
          "columns": []
        },
        "position": 1002
      },
      "computed": {
        "sql": "SELECT CAST(main.id AS TEXT)",
        "type": "string"
      }
    },
    "coordinate_by_location_id": {
      "label": "Coordinates",
      "hiddenInTable": true,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "related-table",
          "colspan": 12,
          "childResource": "coordinate",
          "foreignKey": "location_id",
          "columns": [
            {
              "key": "latitude",
              "label": "Latitude"
            },
            {
              "key": "longitude",
              "label": "Longitude"
            }
          ]
        },
        "position": 1004
      },
      "computed": {
        "sql": "SELECT CAST(main.id AS TEXT)",
        "type": "string"
      }
    },
    "reflex_by_location_id": {
      "label": "Reflexes",
      "hiddenInTable": true,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "related-table",
          "colspan": 12,
          "childResource": "reflex",
          "foreignKey": "location_id",
          "columns": [
            {
              "key": "term",
              "label": "Term"
            },
            {
              "key": "translation",
              "label": "Translation"
            },
            {
              "key": "variety_label",
              "label": "Variety"
            }
          ]
        },
        "position": 1021
      },
      "computed": {
        "sql": "SELECT CAST(main.id AS TEXT)",
        "type": "string"
      }
    }
  },
  "layout": {
    "form": {
      "type": "grid",
      "columns": 12,
      "container": {
        "mode": "modal",
        "size": "xl"
      },
      "items": [
        {
          "id": "place_id",
          "colspan": 6
        },
        {
          "id": "region_id",
          "colspan": 6
        },
        {
          "id": "country_id",
          "colspan": 6
        }
      ]
    }
  }
}
