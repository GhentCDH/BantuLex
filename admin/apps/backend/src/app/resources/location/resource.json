      "id": "display_label",
      "alias": "display_label",
      "label": "Reference",
      "type": "string",
      "sqlExpression": "SELECT COALESCE(NULLIF(concat_ws(', ', (SELECT p.name FROM place p WHERE p.id = x.place_id), (SELECT r.name FROM region r WHERE r.id = x.region_id), (SELECT c.name FROM country c WHERE c.id = x.country_id)), ''), '#' || x.id) FROM \"location\" x WHERE x.id = main.id",
      "hiddenInTable": true,
      "hiddenInView": true
    },
    {
      "id": "place_label",
      "alias": "place_label",
      "label": "Place",
      "type": "string",
      "sqlExpression": "SELECT COALESCE(NULLIF(x.name, ''), '#' || x.id) FROM \"place\" x WHERE x.id = main.\"place_id\"",
