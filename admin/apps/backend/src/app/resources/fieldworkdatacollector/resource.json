{
  "$schema": "https://ghentcdh.github.io/crouton/schema/v1/resource.schema.json",
  "schemaVersion": 1,
  "draft": false,
  "name": "fieldworkdatacollector",
  "route": "fieldworkdatacollector",
  "title": "Fieldwork data collectors",
  "source": {
    "model": "fieldworkdatacollector",
    "datasource": "default",
    "idType": "number"
  },
  "openapi": {
    "tag": "fieldworkdatacollector"
  },
  "sidebar": {
    "group": "fieldwork",
    "hide": false
  },
  "operations": {
    "findAll": {
      "filter": [
        "id",
        "fieldwork_id",
        "data_collector_id",
        "created_at",
        "updated_at"
      ]
    },
    "findOne": true,
    "create": true,
    "update": true,
    "patch": true,
    "delete": true
  },
  "columns": {
    "id": {
      "label": "Id",
      "type": {
        "type": [
          "integer"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": true,
      "createable": false,
      "updateable": false,
      "hiddenInTable": false,
      "idField": true
    },
    "fieldwork_id": {
      "label": "Fieldwork",
      "type": {
        "type": [
          "integer"
        ]
      },
      "hiddenInView": true,
      "hiddenInForm": false,
      "createable": true,
      "updateable": true,
      "hiddenInTable": true,
      "required": true,
      "fieldInput": {
        "type": "autocomplete",
        "relationType": "manyToOne",
        "resource": "../fieldwork/resource.json",
        "options": {
          "valueKey": "id",
          "labelKey": "display_label",
          "storeValue": true,
          "resource": "/fieldwork/schemas",
          "enableCreate": false
        }
      }
    },
    "data_collector_id": {
      "label": "Data collector",
      "type": {
        "type": [
          "integer"
        ]
      },
      "hiddenInView": true,
      "hiddenInForm": false,
      "createable": true,
      "updateable": true,
      "hiddenInTable": true,
      "required": true,
      "fieldInput": {
        "type": "autocomplete",
        "relationType": "manyToOne",
        "resource": "../datacollector/resource.json",
        "options": {
          "valueKey": "id",
          "labelKey": "display_label",
          "storeValue": true,
          "resource": "/datacollector/schemas",
          "enableCreate": false
        }
      }
    },
    "created_at": {
      "label": "Created at",
      "type": {
        "type": [
          "string"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": true,
      "createable": false,
      "updateable": false,
      "hiddenInTable": true
    },
    "updated_at": {
      "label": "Updated at",
      "type": {
        "type": [
          "string"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": true,
      "createable": false,
      "updateable": false,
      "hiddenInTable": true
    },
    "display_label": {
      "label": "Reference",
      "hiddenInTable": true,
      "hiddenInView": true,
      "computed": {
        "sql": "SELECT COALESCE(NULLIF(concat_ws(' \u00b7 ', (SELECT d.name FROM datacollector d WHERE d.id = x.data_collector_id), (SELECT a.archive FROM fieldwork a WHERE a.id = x.fieldwork_id)), ''), '#' || x.id) FROM \"fieldworkdatacollector\" x WHERE x.id = main.id",
        "type": "string"
      }
    },
    "fieldwork_label": {
      "label": "Fieldwork",
      "hiddenInTable": false,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "relation-link",
          "colspan": 12,
          "linkResource": "fieldwork",
          "idKey": "fieldwork_id"
        },
        "position": 0
      },
      "computed": {
        "sql": "SELECT COALESCE(NULLIF(concat_ws(' \u00b7 ', (SELECT p.name FROM project p WHERE p.id = x.project_id), (SELECT y.value FROM collectionyear y WHERE y.id = x.collection_year_id), x.archive), ''), '#' || x.id) FROM \"fieldwork\" x WHERE x.id = main.\"fieldwork_id\"",
        "type": "string"
      }
    },
    "data_collector_label": {
      "label": "Data collector",
      "hiddenInTable": false,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "relation-link",
          "colspan": 12,
          "linkResource": "datacollector",
          "idKey": "data_collector_id"
        },
        "position": 0
      },
      "computed": {
        "sql": "SELECT COALESCE(NULLIF(x.name, ''), '#' || x.id) FROM \"datacollector\" x WHERE x.id = main.\"data_collector_id\"",
        "type": "string"
      }
    }
  },
  "layout": {
    "form": {
      "type": "grid",
      "columns": 12,
      "container": {
        "mode": "modal",
        "size": "xl"
      },
      "items": [
        {
          "id": "fieldwork_id",
          "colspan": 6
        },
        {
          "id": "data_collector_id",
          "colspan": 6
        }
      ]
    }
  }
}
