{
  "$schema": "https://ghentcdh.github.io/crouton/schema/v1/resource.schema.json",
  "schemaVersion": 1,
  "draft": false,
  "name": "fieldworkconsultant",
  "route": "fieldworkconsultant",
  "title": "Fieldwork consultants",
  "source": {
    "model": "fieldworkconsultant",
    "datasource": "default",
    "idType": "number"
  },
  "openapi": {
    "tag": "fieldworkconsultant"
  },
  "sidebar": {
    "group": "fieldwork",
    "hide": false
  },
  "operations": {
    "findAll": {
      "filter": [
        "id",
        "fieldwork_id",
        "consultant_id",
        "created_at",
        "updated_at"
      ]
    },
    "findOne": true,
    "create": true,
    "update": true,
    "patch": true,
    "delete": true
  },
  "columns": {
    "id": {
      "label": "Id",
      "type": {
        "type": [
          "integer"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": true,
      "createable": false,
      "updateable": false,
      "hiddenInTable": false,
      "idField": true
    },
    "fieldwork_id": {
      "label": "Fieldwork",
      "type": {
        "type": [
          "integer"
        ]
      },
      "hiddenInView": true,
      "hiddenInForm": false,
      "createable": true,
      "updateable": true,
      "hiddenInTable": true,
      "required": true,
      "fieldInput": {
        "type": "autocomplete",
        "relationType": "manyToOne",
        "resource": "../fieldwork/resource.json",
        "options": {
          "valueKey": "id",
          "labelKey": "display_label",
          "storeValue": true,
          "resource": "/fieldwork/schemas",
          "enableCreate": false
        }
      }
    },
    "consultant_id": {
      "label": "Consultant",
      "type": {
        "type": [
          "integer"
        ]
      },
      "hiddenInView": true,
      "hiddenInForm": false,
      "createable": true,
      "updateable": true,
      "hiddenInTable": true,
      "required": true,
      "fieldInput": {
        "type": "autocomplete",
        "relationType": "manyToOne",
        "resource": "../consultant/resource.json",
        "options": {
          "valueKey": "id",
          "labelKey": "display_label",
          "storeValue": true,
          "resource": "/consultant/schemas",
          "enableCreate": false
        }
      }
    },
    "created_at": {
      "label": "Created at",
      "type": {
        "type": [
          "string"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": true,
      "createable": false,
      "updateable": false,
      "hiddenInTable": true
    },
    "updated_at": {
      "label": "Updated at",
      "type": {
        "type": [
          "string"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": true,
      "createable": false,
      "updateable": false,
      "hiddenInTable": true
    },
    "display_label": {
      "label": "Reference",
      "hiddenInTable": true,
      "hiddenInView": true,
      "computed": {
        "sql": "SELECT COALESCE(NULLIF(concat_ws(' \u00b7 ', (SELECT d.name FROM consultant d WHERE d.id = x.consultant_id), (SELECT a.archive FROM fieldwork a WHERE a.id = x.fieldwork_id)), ''), '#' || x.id) FROM \"fieldworkconsultant\" x WHERE x.id = main.id",
        "type": "string"
      }
    },
    "fieldwork_label": {
      "label": "Fieldwork",
      "hiddenInTable": false,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "relation-link",
          "colspan": 12,
          "linkResource": "fieldwork",
          "idKey": "fieldwork_id"
        },
        "position": 0
      },
      "computed": {
        "sql": "SELECT COALESCE(NULLIF(concat_ws(' \u00b7 ', (SELECT p.name FROM project p WHERE p.id = x.project_id), (SELECT y.value FROM collectionyear y WHERE y.id = x.collection_year_id), x.archive), ''), '#' || x.id) FROM \"fieldwork\" x WHERE x.id = main.\"fieldwork_id\"",
        "type": "string"
      }
    },
    "consultant_label": {
      "label": "Consultant",
      "hiddenInTable": false,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "relation-link",
          "colspan": 12,
          "linkResource": "consultant",
          "idKey": "consultant_id"
        },
        "position": 0
      },
      "computed": {
        "sql": "SELECT COALESCE(NULLIF(x.name, ''), '#' || x.id) FROM \"consultant\" x WHERE x.id = main.\"consultant_id\"",
        "type": "string"
      }
    }
  },
  "layout": {
    "form": {
      "type": "grid",
      "columns": 12,
      "container": {
        "mode": "modal",
        "size": "xl"
      },
      "items": [
        {
          "id": "fieldwork_id",
          "colspan": 6
        },
        {
          "id": "consultant_id",
          "colspan": 6
        }
      ]
    }
  }
}
