{
  "$schema": "https://ghentcdh.github.io/crouton/schema/v1/resource.schema.json",
  "schemaVersion": 1,
  "draft": false,
  "name": "coordinate",
  "route": "coordinate",
  "title": "Coordinates",
  "source": {
    "model": "coordinate",
    "datasource": "default",
    "idType": "number"
  },
  "openapi": {
    "tag": "coordinate"
  },
  "sidebar": {
    "group": "geography",
    "hide": false
  },
  "operations": {
    "findAll": {
      "search": [
        "description",
        "coordinate_source"
      ],
      "filter": [
        "id",
        "latitude",
        "longitude",
        "coordinate_source",
        "location_id",
        "created_at",
        "updated_at"
      ]
    },
    "findOne": true,
    "create": true,
    "update": true,
    "patch": true,
    "delete": true
  },
  "columns": {
    "id": {
      "label": "Id",
      "type": {
        "type": [
          "integer"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": true,
      "createable": false,
      "updateable": false,
      "hiddenInTable": false,
      "idField": true
    },
    "latitude": {
      "label": "Latitude",
      "type": {
        "type": [
          "number",
          "null"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": false,
      "createable": true,
      "updateable": true,
      "hiddenInTable": false,
      "required": false,
      "fieldInput": {
        "type": "number"
      }
    },
    "longitude": {
      "label": "Longitude",
      "type": {
        "type": [
          "number",
          "null"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": false,
      "createable": true,
      "updateable": true,
      "hiddenInTable": false,
      "required": false,
      "fieldInput": {
        "type": "number"
      }
    },
    "description": {
      "label": "Description",
      "type": {
        "type": [
          "string",
          "null"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": false,
      "createable": true,
      "updateable": true,
      "hiddenInTable": true,
      "required": false,
      "fieldInput": {
        "type": "textarea"
      }
    },
    "coordinate_source": {
      "label": "Coordinate source",
      "type": {
        "type": [
          "string",
          "null"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": false,
      "createable": true,
      "updateable": true,
      "hiddenInTable": false,
      "required": false,
      "fieldInput": {
        "type": "string"
      }
    },
    "location_id": {
      "label": "Location",
      "type": {
        "type": [
          "integer",
          "null"
        ]
      },
      "hiddenInView": true,
      "hiddenInForm": false,
      "createable": true,
      "updateable": true,
      "hiddenInTable": true,
      "required": false,
      "fieldInput": {
        "type": "autocomplete",
        "relationType": "manyToOne",
        "resource": "../location/resource.json",
        "options": {
          "valueKey": "id",
          "labelKey": "display_label",
          "storeValue": true,
          "resource": "/location/schemas",
          "enableCreate": false
        }
      }
    },
    "created_at": {
      "label": "Created at",
      "type": {
        "type": [
          "string"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": true,
      "createable": false,
      "updateable": false,
      "hiddenInTable": true
    },
    "updated_at": {
      "label": "Updated at",
      "type": {
        "type": [
          "string"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": true,
      "createable": false,
      "updateable": false,
      "hiddenInTable": true
    },
    "display_label": {
      "label": "Reference",
      "hiddenInTable": true,
      "hiddenInView": true,
      "computed": {
        "sql": "SELECT COALESCE(NULLIF(concat_ws(', ', x.latitude, x.longitude), ''), '#' || x.id) FROM \"coordinate\" x WHERE x.id = main.id",
        "type": "string"
      }
    },
    "coordinate_map": {
      "label": "Map",
      "hiddenInTable": true,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "coordinate-map",
          "colspan": 12
        }
      },
      "computed": {
        "sql": "SELECT json_object('id', main.id, 'latitude', main.latitude, 'longitude', main.longitude, 'description', main.description)",
        "type": "string"
      }
    },
    "location_label": {
      "label": "Location",
      "hiddenInTable": false,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "relation-link",
          "colspan": 12,
          "linkResource": "location",
          "idKey": "location_id"
        },
        "position": 3
      },
      "computed": {
        "sql": "SELECT COALESCE(NULLIF(concat_ws(', ', (SELECT p.name FROM place p WHERE p.id = x.place_id), (SELECT r.name FROM region r WHERE r.id = x.region_id), (SELECT c.name FROM country c WHERE c.id = x.country_id)), ''), '#' || x.id) FROM \"location\" x WHERE x.id = main.\"location_id\"",
        "type": "string"
      }
    }
  },
  "layout": {
    "form": {
      "type": "grid",
      "columns": 12,
      "container": {
        "mode": "modal",
        "size": "xl"
      },
      "items": [
        {
          "id": "latitude",
          "colspan": 6
        },
        {
          "id": "longitude",
          "colspan": 6
        },
        {
          "id": "description",
          "colspan": 12
        },
        {
          "id": "coordinate_source",
          "colspan": 6
        },
        {
          "id": "location_id",
          "colspan": 6
        }
      ]
    }
  }
}
