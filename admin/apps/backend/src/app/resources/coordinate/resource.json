  "calculatedColumns": [
    {
      "id": "display_label",
      "alias": "display_label",
      "label": "Reference",
      "type": "string",
      "sqlExpression": "SELECT COALESCE(NULLIF(concat_ws(', ', x.latitude, x.longitude), ''), '#' || x.id) FROM \"coordinate\" x WHERE x.id = main.id",
      "hiddenInTable": true,
      "hiddenInView": true
    },
    {
      "id": "coordinate_map",
      "alias": "coordinate_map",
      "label": "Map",
      "type": "string",
      "sqlExpression": "SELECT json_object('id', main.id, 'latitude', main.latitude, 'longitude', main.longitude, 'description', main.description)",
      "hiddenInTable": true,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "coordinate-map",
          "colspan": 12
        }
      }
    },
    {
      "id": "location_label",
      "alias": "location_label",
      "label": "Location",
      "type": "string",
      "sqlExpression": "SELECT COALESCE(NULLIF(concat_ws(', ', (SELECT p.name FROM place p WHERE p.id = x.place_id), (SELECT r.name FROM region r WHERE r.id = x.region_id), (SELECT c.name FROM country c WHERE c.id = x.country_id)), ''), '#' || x.id) FROM \"location\" x WHERE x.id = main.\"location_id\"",
      "position": 3,
      "hiddenInTable": false,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "relation-link",
          "colspan": 12,
          "linkResource": "location",
          "idKey": "location_id"
        }
      }
    }
  ]
