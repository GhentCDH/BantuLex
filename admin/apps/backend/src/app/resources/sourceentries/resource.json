{
  "$schema": "https://ghentcdh.github.io/crouton/schema/v1/resource.schema.json",
  "schemaVersion": 1,
  "draft": false,
  "name": "sourceentries",
  "route": "sourceentries",
  "title": "Source entries",
  "source": {
    "model": "sourceentries",
    "datasource": "default",
    "idType": "number"
  },
  "openapi": {
    "tag": "sourceentries"
  },
  "sidebar": {
    "group": "sources",
    "hide": false
  },
  "operations": {
    "findAll": {
      "search": [
        "role",
        "pages"
      ],
      "filter": [
        "id",
        "role",
        "order",
        "pages",
        "entry_id",
        "source_id",
        "created_at",
        "updated_at"
      ]
    },
    "findOne": true,
    "create": true,
    "update": true,
    "patch": true,
    "delete": true
  },
  "columns": {
    "id": {
      "label": "Id",
      "type": {
        "type": [
          "integer"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": true,
      "createable": false,
      "updateable": false,
      "hiddenInTable": false,
      "idField": true
    },
    "role": {
      "label": "Role",
      "type": {
        "type": [
          "string"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": false,
      "createable": true,
      "updateable": true,
      "hiddenInTable": false,
      "required": true,
      "fieldInput": {
        "type": "string"
      }
    },
    "order": {
      "label": "Order",
      "type": {
        "type": [
          "integer"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": false,
      "createable": true,
      "updateable": true,
      "hiddenInTable": false,
      "required": true,
      "fieldInput": {
        "type": "number"
      }
    },
    "pages": {
      "label": "Pages",
      "type": {
        "type": [
          "string",
          "null"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": false,
      "createable": true,
      "updateable": true,
      "hiddenInTable": false,
      "required": false,
      "fieldInput": {
        "type": "string"
      }
    },
    "entry_id": {
      "label": "Reflex",
      "type": {
        "type": [
          "integer",
          "null"
        ]
      },
      "hiddenInView": true,
      "hiddenInForm": false,
      "createable": true,
      "updateable": true,
      "hiddenInTable": true,
      "required": false,
      "fieldInput": {
        "type": "autocomplete",
        "relationType": "manyToOne",
        "resource": "../reflex/resource.json",
        "options": {
          "valueKey": "id",
          "labelKey": "display_label",
          "storeValue": true,
          "resource": "/reflex/schemas",
          "enableCreate": false
        }
      }
    },
    "source_id": {
      "label": "Source",
      "type": {
        "type": [
          "integer",
          "null"
        ]
      },
      "hiddenInView": true,
      "hiddenInForm": false,
      "createable": true,
      "updateable": true,
      "hiddenInTable": true,
      "required": false,
      "fieldInput": {
        "type": "autocomplete",
        "relationType": "manyToOne",
        "resource": "../source/resource.json",
        "options": {
          "valueKey": "id",
          "labelKey": "display_label",
          "storeValue": true,
          "resource": "/source/schemas",
          "enableCreate": false
        }
      }
    },
    "created_at": {
      "label": "Created at",
      "type": {
        "type": [
          "string"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": true,
      "createable": false,
      "updateable": false,
      "hiddenInTable": true
    },
    "updated_at": {
      "label": "Updated at",
      "type": {
        "type": [
          "string"
        ]
      },
      "hiddenInView": false,
      "hiddenInForm": true,
      "createable": false,
      "updateable": false,
      "hiddenInTable": true
    },
    "display_label": {
      "label": "Reference",
      "hiddenInTable": true,
      "hiddenInView": true,
      "computed": {
        "sql": "SELECT COALESCE(NULLIF(concat_ws(' \u00b7 ', x.role, (SELECT s.author_year FROM source s WHERE s.id = x.source_id)), ''), '#' || x.id) FROM \"sourceentries\" x WHERE x.id = main.id",
        "type": "string"
      }
    },
    "entry_label": {
      "label": "Reflex",
      "hiddenInTable": false,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "relation-link",
          "colspan": 12,
          "linkResource": "reflex",
          "idKey": "entry_id"
        },
        "position": 3
      },
      "computed": {
        "sql": "SELECT COALESCE(NULLIF(concat_ws(' \u00b7 ', x.term, x.translation), ''), '#' || x.id) FROM \"reflex\" x WHERE x.id = main.\"entry_id\"",
        "type": "string"
      }
    },
    "source_label": {
      "label": "Source",
      "hiddenInTable": false,
      "hiddenInView": false,
      "fieldInput": {
        "type": "string",
        "options": {
          "format": "relation-link",
          "colspan": 12,
          "linkResource": "source",
          "idKey": "source_id"
        },
        "position": 3
      },
      "computed": {
        "sql": "SELECT COALESCE(NULLIF(x.author_year, ''), '#' || x.id) FROM \"source\" x WHERE x.id = main.\"source_id\"",
        "type": "string"
      }
    }
  },
  "layout": {
    "form": {
      "type": "grid",
      "columns": 12,
      "container": {
        "mode": "modal",
        "size": "xl"
      },
      "items": [
        {
          "id": "role",
          "colspan": 6
        },
        {
          "id": "order",
          "colspan": 6
        },
        {
          "id": "pages",
          "colspan": 6
        },
        {
          "id": "entry_id",
          "colspan": 6
        },
        {
          "id": "source_id",
          "colspan": 6
        }
      ]
    }
  }
}
