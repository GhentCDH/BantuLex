generator client {
  provider = "prisma-client-js"
}

generator crouton {
  provider  = "crouton-prisma"
  zodOutput = "../../generated/types"
}

datasource db {
  provider = "sqlite"
}

model blrconsonantstructure {
  id             Int              @id @default(autoincrement())
  created_at     String           @default(dbgenerated("CURRENT_TIMESTAMP"))
  updated_at     String           @default(dbgenerated("CURRENT_TIMESTAMP"))
  c1             String?
  c2             String?
  c3             String?
  c4             String?
  cs             String?
  reconstruction reconstruction[]
}

model blrcontributor {
  id             Int              @id @default(autoincrement())
  created_at     String           @default(dbgenerated("CURRENT_TIMESTAMP"))
  updated_at     String           @default(dbgenerated("CURRENT_TIMESTAMP"))
  name           String?
  reconstruction reconstruction[]
}

model blrreliability {
  id             Int              @id @default(autoincrement())
  created_at     String           @default(dbgenerated("CURRENT_TIMESTAMP"))
  updated_at     String           @default(dbgenerated("CURRENT_TIMESTAMP"))
  value          String?
  reconstruction reconstruction[]
}

model blrtonestructure {
  id             Int              @id @default(autoincrement())
  created_at     String           @default(dbgenerated("CURRENT_TIMESTAMP"))
  updated_at     String           @default(dbgenerated("CURRENT_TIMESTAMP"))
  t11            String?
  t12            String?
  t21            String?
  t22            String?
  t3             String?
  t4             String?
  reconstruction reconstruction[]
}

model blrvowelstructure {
  id             Int              @id @default(autoincrement())
  created_at     String           @default(dbgenerated("CURRENT_TIMESTAMP"))
  updated_at     String           @default(dbgenerated("CURRENT_TIMESTAMP"))
  v11            String?
  v12            String?
  v21            String?
  v22            String?
  v3             String?
  v4             String?
  reconstruction reconstruction[]
}

model collectionyear {
  id         Int         @id @default(autoincrement())
  created_at String      @default(dbgenerated("CURRENT_TIMESTAMP"))
  updated_at String      @default(dbgenerated("CURRENT_TIMESTAMP"))
  value      String?
  status     String
  fieldwork  fieldwork[]
}

model coordinate {
  id                Int       @id @default(autoincrement())
  created_at        String    @default(dbgenerated("CURRENT_TIMESTAMP"))
  updated_at        String    @default(dbgenerated("CURRENT_TIMESTAMP"))
  latitude          Float?
  longitude         Float?
  description       String?
  coordinate_source String?
  location_id       Int?
  location          location? @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model country {
  id         Int        @id @default(autoincrement())
  created_at String     @default(dbgenerated("CURRENT_TIMESTAMP"))
  updated_at String     @default(dbgenerated("CURRENT_TIMESTAMP"))
  name       String?
  location   location[]
  region     region[]
}

model datacollector {
  id                     Int                      @id @default(autoincrement())
  created_at             String                   @default(dbgenerated("CURRENT_TIMESTAMP"))
  updated_at             String                   @default(dbgenerated("CURRENT_TIMESTAMP"))
  name                   String?
  fieldworkdatacollector fieldworkdatacollector[]
}

model fieldwork {
  id                     Int                      @id @default(autoincrement())
  created_at             String                   @default(dbgenerated("CURRENT_TIMESTAMP"))
  updated_at             String                   @default(dbgenerated("CURRENT_TIMESTAMP"))
  project_id             Int?
  collection_year_id     Int?
  archive                String?
  data_entered_by        String?
  bulkimport             bulkimport[]
  collectionyear         collectionyear?          @relation(fields: [collection_year_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project                project?                 @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fieldworkconsultant    fieldworkconsultant[]
  fieldworkdatacollector fieldworkdatacollector[]
  reflex                 reflex[]
}

model fieldworkdatacollector {
  id                Int           @id @default(autoincrement())
  created_at        String        @default(dbgenerated("CURRENT_TIMESTAMP"))
  updated_at        String        @default(dbgenerated("CURRENT_TIMESTAMP"))
  fieldwork_id      Int
  data_collector_id Int
  datacollector     datacollector @relation(fields: [data_collector_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fieldwork         fieldwork     @relation(fields: [fieldwork_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([fieldwork_id, data_collector_id], map: "sqlite_autoindex_fieldworkdatacollector_1")
}

model location {
  id         Int          @id @default(autoincrement())
  created_at String       @default(dbgenerated("CURRENT_TIMESTAMP"))
  updated_at String       @default(dbgenerated("CURRENT_TIMESTAMP"))
  place_id   Int?
  region_id  Int?
  country_id Int?
  bulkimport bulkimport[]
  coordinate coordinate[]
  country    country?     @relation(fields: [country_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  region     region?      @relation(fields: [region_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  place      place?       @relation(fields: [place_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reflex     reflex[]
}

model place {
  id         Int        @id @default(autoincrement())
  created_at String     @default(dbgenerated("CURRENT_TIMESTAMP"))
  updated_at String     @default(dbgenerated("CURRENT_TIMESTAMP"))
  name       String?
  region_id  Int?
  location   location[]
  region     region?    @relation(fields: [region_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model project {
  id         Int         @id @default(autoincrement())
  created_at String      @default(dbgenerated("CURRENT_TIMESTAMP"))
  updated_at String      @default(dbgenerated("CURRENT_TIMESTAMP"))
  name       String?
  fieldwork  fieldwork[]
}

model reconstruction {
  id                     Int                    @id @default(autoincrement())
  created_at             String                 @default(dbgenerated("CURRENT_TIMESTAMP"))
  updated_at             String                 @default(dbgenerated("CURRENT_TIMESTAMP"))
  blr_index              Int?
  word_tone              String?
  word                   String?
  english                String?
  french                 String?
  noun_class             String?
  distribution           String?
  note                   String?
  proto_kk               String?
  date_of_entry          String?
  contributor_id         Int?
  reliability_id         Int?
  consonant_structure_id Int?
  vowel_structure_id     Int?
  tone_structure_id      Int?
  blrtonestructure       blrtonestructure?      @relation(fields: [tone_structure_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  blrvowelstructure      blrvowelstructure?     @relation(fields: [vowel_structure_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  blrconsonantstructure  blrconsonantstructure? @relation(fields: [consonant_structure_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  blrreliability         blrreliability?        @relation(fields: [reliability_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  blrcontributor         blrcontributor?        @relation(fields: [contributor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reflex                 reflex[]

  @@index([blr_index], map: "ix_reconstruction_blr_index")
}

model reflex {
  id                  Int             @id @default(autoincrement())
  created_at          String          @default(dbgenerated("CURRENT_TIMESTAMP"))
  updated_at          String          @default(dbgenerated("CURRENT_TIMESTAMP"))
  original_id         Int?
  beginning_id        Int?            @unique(map: "ix_reflex_beginning_id")
  term                String?
  term_morph_analysis String?
  translation         String?
  meaning             String?
  scientific_name     String?
  semantic_field      String?
  part_of_speech      String?
  reconstruction_note String?
  ipa                 String?
  notes_on_ipa        String?
  notes               String?
  variety_id          Int?
  location_id         Int?
  fieldwork_id        Int?
  blr_entry_id        Int?
  bulkimport_id       Int?
  reconstruction      reconstruction? @relation(fields: [blr_entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fieldwork           fieldwork?      @relation(fields: [fieldwork_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  location            location?       @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  variety             variety?        @relation(fields: [variety_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bulkimport          bulkimport?     @relation(fields: [bulkimport_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sourceentries       sourceentries[]

  @@index([bulkimport_id], map: "ix_reflex_bulkimport_id")
}

model region {
  id         Int        @id @default(autoincrement())
  created_at String     @default(dbgenerated("CURRENT_TIMESTAMP"))
  updated_at String     @default(dbgenerated("CURRENT_TIMESTAMP"))
  name       String?
  country_id Int?
  location   location[]
  place      place[]
  country    country?   @relation(fields: [country_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model source {
  id             Int             @id @default(autoincrement())
  created_at     String          @default(dbgenerated("CURRENT_TIMESTAMP"))
  updated_at     String          @default(dbgenerated("CURRENT_TIMESTAMP"))
  author_year    String?
  year_uncertain Boolean
  title          String?
  bulkimport     bulkimport[]
  sourceentries  sourceentries[]
}

model sourceentries {
  id         Int     @id @default(autoincrement())
  created_at String  @default(dbgenerated("CURRENT_TIMESTAMP"))
  updated_at String  @default(dbgenerated("CURRENT_TIMESTAMP"))
  role       String
  order      Int
  pages      String?
  entry_id   Int?
  source_id  Int?
  source     source? @relation(fields: [source_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  entry      reflex? @relation(fields: [entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([role], map: "ix_sourceentries_role")
  @@index([source_id], map: "ix_sourceentries_source_id")
  @@index([entry_id], map: "ix_sourceentries_entry_id")
}

model variety {
  id                Int          @id @default(autoincrement())
  created_at        String       @default(dbgenerated("CURRENT_TIMESTAMP"))
  updated_at        String       @default(dbgenerated("CURRENT_TIMESTAMP"))
  name_english      String?
  name_french       String?
  name_bantu        String?
  name_bastin       String?
  branch            String?
  branch_detailed   String?
  bastin_index      String?
  guthrie_index     String?
  guthrie_plus      String?
  substrate_suspect Boolean?
  bulkimport        bulkimport[]
  reflex            reflex[]
}

model consultant {
  id                  Int                   @id @default(autoincrement())
  created_at          String                @default(dbgenerated("CURRENT_TIMESTAMP"))
  updated_at          String                @default(dbgenerated("CURRENT_TIMESTAMP"))
  name                String?
  fieldworkconsultant fieldworkconsultant[]
}

model fieldworkconsultant {
  id            Int        @id @default(autoincrement())
  created_at    String     @default(dbgenerated("CURRENT_TIMESTAMP"))
  updated_at    String     @default(dbgenerated("CURRENT_TIMESTAMP"))
  fieldwork_id  Int
  consultant_id Int
  consultant    consultant @relation(fields: [consultant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fieldwork     fieldwork  @relation(fields: [fieldwork_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([fieldwork_id, consultant_id], map: "sqlite_autoindex_fieldworkconsultant_1")
}

model bulkimport {
  id              Int        @id @default(autoincrement())
  created_at      String     @default(dbgenerated("CURRENT_TIMESTAMP"))
  updated_at      String     @default(dbgenerated("CURRENT_TIMESTAMP"))
  label           String?
  note            String?
  rows            Int
  status          String
  undone_at       String?
  role            String?
  source_id       Int?
  variety_id      Int?
  location_id     Int?
  fieldwork_id    Int?
  source_created  Boolean
  variety_created Boolean
  fieldwork       fieldwork? @relation(fields: [fieldwork_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  location        location?  @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  variety         variety?   @relation(fields: [variety_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  source          source?    @relation(fields: [source_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reflex          reflex[]
}
