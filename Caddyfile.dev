{
	auto_https off
}

:80 {
	# site/ is the web root; the Pihka engine and the map extension come from the submodule.
	@pihka path /core/* /extensions/point_map/*
	root @pihka /srv/pihka
	root * /srv/site

    @revalidate path *.html *.js *.css *.json *.wasm *.mjs *.db *.sqlite *.geojson /
    header @revalidate Cache-Control "no-cache"

    @sqlite path *.db *.sqlite
    header @sqlite Content-Type application/vnd.sqlite3

	encode {
		zstd
		gzip 5
		minimum_length 1024
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/geo+json*
			header Content-Type application/javascript*
			header Content-Type application/xml*
			header Content-Type application/wasm
			header Content-Type application/vnd.sqlite3
			header Content-Type image/svg+xml
		}
	}
	file_server {
		precompressed
	}
}
