# Default recipe: start the local web server
default: run

# Start Caddy on port 3030
run:
    caddy run --config Caddyfile

# Download the latest Protomaps world basemap (maxzoom 7)
download:
    node scripts/download-world-pmtiles.js

# Download Bantu region extract (Sub-Saharan Africa)
download-africa:
    node scripts/download-world-pmtiles.js --bbox=10,-35,45,10 --output=africa.pmtiles --maxzoom=8

# Export BantuLex data from database to GeoJSON (original map)
export:
    uv run python scripts/export_bantulex.py

# Export BantuLex + BLR phonological data (Klankzoeker)
export-blr:
    uv run python scripts/export_blr.py
